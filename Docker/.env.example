# A DNS name only; no scheme, path, or port. Point its A/AAAA records at this host.
COINY_HOST=money.example.com
ACME_EMAIL=admin@example.com
# Generate two different values with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_KEY=
# Optional SMTP (STARTTLS). Leave empty to use saved offline recovery codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
# Use single quotes around a password containing $ or #.
SMTP_PASSWORD=
# Keep this project name and node/storage identity stable after installation.
COMPOSE_PROJECT_NAME=coiny
COINY_VERSION=local
# Change both if the default Docker subnet conflicts with another network.
COINY_PROXY_SUBNET=172.30.16.0/24
COINY_PROXY_IP=172.30.16.3
